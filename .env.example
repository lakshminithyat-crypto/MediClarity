# VITE_GEMINI_API_KEY: Required when deploying as a static Vite app (e.g. Vercel).
# Add this environment variable in your Vercel project settings.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY: Fallback key automatically injected in Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
